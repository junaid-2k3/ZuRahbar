<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws the splash itself through the SplashScreen API and
         ignores android:windowBackground, so the layer-list in
         drawable/launch_background.xml never appears here. Name the brand
         colours explicitly: without this the background is whatever the
         platform picks, which flashes white on a light-mode device. -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/brand_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
